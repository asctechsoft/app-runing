// STRIDE backend schema (B06, C02).
// Quy ước để đổi provider sqlite <-> postgresql không phải sửa model:
//  - Không dùng Prisma enum: lưu String, validate bằng zod (src/server/validators).
//  - Không dùng Json/scalar list: lưu JSON dưới dạng String (cột *Json).
//  - Thời điểm lưu DateTime (độ chính xác ms); API trả UTC epoch ms.
//  - Khoảng cách: mét (Float). Thời lượng: mili giây (Int).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id
  email               String    @unique
  passwordHash        String
  emailVerifiedAt     DateTime?
  displayName         String?
  avatarKey           String?
  // active | deleting | deleted
  status              String    @default("active")
  deletionRequestedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  profile       Profile?
}

// Một "family" refresh token = một phiên đăng nhập trên một thiết bị.
model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  // lý do thu hồi: logout | reuse | passwordReset | accountDeleted
  revokeReason String?
  reauthAt   DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
}

model EmailToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // verifyEmail | resetPassword
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model IdempotencyRecord {
  id           String   @id
  userId       String
  key          String
  method       String
  path         String
  requestHash  String
  statusCode   Int
  responseBody String
  responseHash String
  createdAt    DateTime @default(now())

  @@unique([userId, key])
}

model Profile {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String?
  heightCm           Float?
  weightKg           Float?
  activityLevel      String?
  runningExperience  String?
  distanceUnit       String   @default("km")
  weightUnit         String   @default("kg")
  heightUnit         String   @default("cm")
  weekStart          Int      @default(1)
  locale             String   @default("en")
  audioCuesJson      String   @default("{\"enabled\":true,\"everyKm\":1,\"voice\":null}")
  autoPause          Boolean  @default(false)
  sourcePriorityJson String   @default("[\"phoneSensor\"]")
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Append-only: không sửa/xóa version cũ.
model GoalVersion {
  id            String   @id
  ownerId       String
  type          String
  value         Float
  effectiveFrom String
  createdAt     DateTime @default(now())

  @@index([ownerId, type, effectiveFrom])
}

// E03: giữ chỗ ID hoạt động guest đang được claim cho tài khoản.
model GuestClaim {
  activityId String   @id
  userId     String
  guestId    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Activity {
  id              String    @id
  ownerId         String
  type            String
  status          String
  startedAt       DateTime
  endedAt         DateTime?
  tzId            String
  tzOffsetMin     Int
  distanceM       Float?
  movingMs        Int
  elapsedMs       Int
  avgPaceSecPerKm Float?
  steps           Int?
  caloriesKcal    Float?
  calorieModel    String?
  weightKgUsed    Float?
  title           String
  feeling         String?
  notes           String?
  privacy         String    @default("onlyMe")
  // Chủ sở hữu chủ động cho phép chia sẻ tọa độ điểm đầu/cuối (J04).
  shareRoute      Boolean   @default(false)
  goalJson        String?
  hasGps          Boolean   @default(false)
  distanceSource  String
  workoutExecutionId String?
  contentHash     String
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([ownerId, startedAt])
}

model Track {
  activityId   String    @id
  ownerId      String
  // uploading | finalized
  status       String    @default("uploading")
  totalChunks  Int?
  storageKey   String?
  sha256       String?
  pointCount   Int?
  segmentCount Int?
  startLat     Float?
  startLon     Float?
  endLat       Float?
  endLon       Float?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([ownerId])
}

model TrackChunk {
  id         String   @id
  activityId String
  ownerId    String
  seq        Int
  sha256     String
  bytes      Int
  storageKey String
  createdAt  DateTime @default(now())

  @@unique([activityId, seq])
}

model Attachment {
  id          String    @id
  activityId  String
  ownerId     String
  mime        String
  bytes       Int
  sha256      String?
  storageKey  String
  // pending | uploaded
  uploadState String    @default("pending")
  revision    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, activityId])
}

// H03/H04: chuỗi thay đổi đơn điệu cho sync pull. Không bao giờ xóa bản ghi tombstone.
model ChangeLog {
  seq       Int      @id @default(autoincrement())
  ownerId   String
  entity    String
  entityId  String
  op        String
  createdAt DateTime @default(now())

  @@index([ownerId, seq])
}

model Job {
  id          String    @id
  ownerId     String
  // export | deleteAccount
  kind        String
  // queued | running | succeeded | failed
  status      String    @default("queued")
  resultKey   String?
  error       String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([ownerId, kind])
}

model NotificationItem {
  id        String    @id
  ownerId   String
  kind      String
  title     String
  body      String
  deepLink  String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([ownerId, createdAt])
}

model Club {
  id          String   @id
  name        String
  description String   @default("")
  regionText  String
  // Chuỗi chữ thường (name + region) để tìm kiếm portable giữa sqlite/postgres.
  searchText  String
  lat         Float?
  lon         Float?
  ownerId     String
  isDevFixture Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]

  @@index([searchText])
}

model Membership {
  id        String   @id
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  // owner | mod | member
  role      String   @default("member")
  // pending | approved | rejected | left
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, userId])
  @@index([userId, status])
}

model ClubPost {
  id         String    @id
  clubId     String
  authorId   String
  activityId String?
  text       String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([clubId, createdAt])
}

model Comment {
  id        String    @id
  postId    String
  authorId  String
  text      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([postId, createdAt])
}

model Cheer {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model Report {
  id         String   @id
  reporterId String
  targetType String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())

  @@unique([reporterId, targetType, targetId])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model ClubEvent {
  id           String    @id
  clubId       String
  creatorId    String
  title        String
  description  String    @default("")
  startAt      DateTime
  endAt        DateTime?
  tzId         String
  meetingPlace String
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([clubId, startAt])
}

model Rsvp {
  eventId   String
  userId    String
  // going | cancelled
  status    String
  updatedAt DateTime @updatedAt

  @@id([eventId, userId])
}

model Challenge {
  id                String   @id
  title             String
  description       String   @default("")
  ruleVersion       Int      @default(1)
  activityTypesJson String
  startDate         String
  endDate           String
  tzId              String
  // distance | count | time
  targetType        String
  targetValue       Float
  badgeKey          String?
  isDevFixture      Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model ChallengeParticipant {
  id               String    @id
  challengeId      String
  userId           String
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  progressValue    Float     @default(0)
  completedAt      DateTime?
  leaderboardOptIn Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  @@unique([challengeId, userId])
  @@index([userId])
}

model Badge {
  id          String   @id
  userId      String
  challengeId String
  badgeKey    String?
  awardedAt   DateTime @default(now())

  @@unique([userId, challengeId])
}

model Route {
  id           String   @id
  name         String
  region       String
  regionLower  String
  distanceM    Float
  surface      String
  polyline     String
  attribution  String
  startLat     Float?
  startLon     Float?
  isDevFixture Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([regionLower])
}

model SavedRoute {
  userId    String
  routeId   String
  createdAt DateTime @default(now())

  @@id([userId, routeId])
}

model LiveShare {
  id            String    @id
  activityId    String
  ownerId       String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  stoppedAt     DateTime?
  stopReason    String?
  lastPointJson String?
  lastUpdateAt  DateTime?

  viewers LiveShareViewer[]

  @@index([activityId])
}

model LiveShareViewer {
  liveShareId String
  liveShare   LiveShare @relation(fields: [liveShareId], references: [id], onDelete: Cascade)
  userId      String

  @@id([liveShareId, userId])
  @@index([userId])
}
