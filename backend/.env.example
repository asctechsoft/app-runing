# Sao chép thành .env rồi điền giá trị. KHÔNG commit .env.
NODE_ENV=development
# SQLite cho dev/test. Production: postgresql://user:pass@host:5432/stride (xem README "Đổi sang PostgreSQL").
DATABASE_URL="file:./dev.db"
# Bí mật ký JWT/URL ký số. Tối thiểu 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# URL công khai của API (dùng để dựng link xác minh email, URL upload/download ký số).
PUBLIC_BASE_URL=http://localhost:3001
# Link mở app cho email xác minh/đặt lại mật khẩu.
APP_LINK_BASE=stride://auth
# Thư mục lưu file local (StorageDriver = local). Đã gitignore.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# console (dev: in link ra log) | memory (test)
MAILER_DRIVER=console
# inline: chạy job export/xóa tài khoản ngay trong process | manual: chạy bằng `npm run jobs`
JOB_RUNNER=inline
# Firebase Auth (đăng nhập Google). Chỉ cần project ID: token được xác minh bằng JWKS công khai của Google,
# không cần service account. Bỏ trống => POST /auth/firebase trả 503 provider_not_configured.
FIREBASE_PROJECT_ID=app-runing-667b3
# Giới hạn tần suất (số request / phút)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SOCIAL_PER_MIN=30
# Số request / giờ
RATE_LIMIT_LOOKUP_PER_HOUR=20
RATE_LIMIT_FEEDBACK_PER_HOUR=10
